{
  "name": "oramix-ai-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ./src/telemetry/instrumentation.js --watch src/server.js",
    "start": "node --import ./src/telemetry/instrumentation.js src/server.js",
    "import:pillars": "node src/scripts/importCsv/importPillars.js",
    "import:questions": "node src/scripts/importCsv/importQuestions.js",
    "import:assessment-answers": "node src/scripts/importCsv/importAssessmentAnswers.js",
    "import:importar": "node src/scripts/importCsv/importImportarFolder.js",
    "import:all": "node src/scripts/importCsv/importAll.js",
    "import:configuration": "node src/scripts/importConfiguration.js",
    "seed:templates": "node src/scripts/seedAssessmentTemplates.js",
    "migrate:remove-legacy-qr": "node src/scripts/removeLegacyQrTokens.js",
    "create:admin": "node src/scripts/createAdminUser.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-mongoose": "^0.68.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "otplib": "^12.0.1",
    "pptxgenjs": "^4.0.1",
    "redis": "^6.2.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "magic-string": "1.2.3",
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
