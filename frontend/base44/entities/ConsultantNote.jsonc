{
  "name": "ConsultantNote",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "title": "Assessment ID"
    },
    "pillar_code": {
      "type": "string",
      "title": "Pillar Code"
    },
    "gap_description": {
      "type": "string",
      "title": "Gap Description"
    },
    "mitigation": {
      "type": "string",
      "title": "Mitigation Measures"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "effort": {
      "type": "string",
      "title": "Effort",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "impact": {
      "type": "string",
      "title": "Impact",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "required": [
    "assessment_id",
    "pillar_code"
  ]
}