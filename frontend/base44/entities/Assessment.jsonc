{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started"
    },
    "started_at": {
      "type": "string",
      "title": "Started At"
    },
    "completed_at": {
      "type": "string",
      "title": "Completed At"
    },
    "global_score": {
      "type": "number",
      "title": "Global Score"
    },
    "maturity_level": {
      "type": "string",
      "title": "Maturity Level"
    },
    "pillar_scores": {
      "type": "string",
      "title": "Pillar Scores JSON"
    },
    "language": {
      "type": "string",
      "title": "Language",
      "enum": [
        "pt",
        "en"
      ],
      "default": "pt"
    },
    "assessment_type": {
      "type": "string",
      "title": "Assessment Type",
      "enum": [
        "main",
        "sub_assessment"
      ],
      "default": "main"
    },
    "parent_assessment_id": {
      "type": "string",
      "title": "Parent Assessment ID"
    },
    "sub_assessment_for_pillar": {
      "type": "string",
      "title": "Sub-Assessment For Pillar"
    },
    "reviewed_by_consultant": {
      "type": "boolean",
      "title": "Reviewed by Consultant",
      "default": false
    }
  },
  "required": [
    "customer_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ai_consultant"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ai_consultant"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ai_consultant"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ai_consultant"
          }
        }
      ]
    }
  }
}