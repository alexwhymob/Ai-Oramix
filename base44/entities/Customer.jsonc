{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "role": {
      "type": "string",
      "title": "Job Title"
    },
    "sector": {
      "type": "string",
      "title": "Sector"
    },
    "company_size": {
      "type": "string",
      "title": "Company Size",
      "enum": [
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1000+"
      ]
    },
    "qr_token": {
      "type": "string",
      "title": "QR Token"
    },
    "registered_by": {
      "type": "string",
      "title": "Registered By",
      "enum": [
        "self",
        "admin"
      ],
      "default": "self"
    },
    "language": {
      "type": "string",
      "title": "Preferred Language",
      "enum": [
        "pt",
        "en"
      ],
      "default": "pt"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "account_manager_id": {
      "type": "string",
      "title": "Account Manager"
    }
  },
  "required": [
    "name",
    "email",
    "company"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ai_consultant"
          }
        },
        {
          "data.account_manager_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "account_manager"
              }
            },
            {
              "$or": [
                {
                  "data.account_manager_id": "{{user.id}}"
                },
                {
                  "created_by": "{{user.email}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}